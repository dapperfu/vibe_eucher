{
  "_comment": "EucherHeuristicTiebreak trains only on heuristic gray areas: close bids, plays, and discards.",
  "model": {
    "name": "EucherHeuristicTiebreak",
    "hidden_size": 16,
    "trick_band": 0.55,
    "advantage_margin": 0.012,
    "weight_margin": 3.0,
    "call_threshold": 0.5
  },
  "data": {
    "version": "v2",
    "train_path": "data/EucherHeuristicTiebreak/v2",
    "hands": 200,
    "seed": 13,
    "val_fraction": 0.15,
    "test_fraction": 0.15,
    "source": "simulated euchre deals played by the rules-and-payoff heuristic",
    "preprocessing": "Drop clear decisions. Keep close bids, plays, and discards."
  },
  "training": {
    "learning_rate": 0.01,
    "weight_decay": 0.0001,
    "epochs": 30,
    "batch_size": 64
  },
  "evaluation": {
    "metrics": ["accuracy", "precision", "recall", "f1"],
    "split": "test"
  },
  "checkpoint": {
    "directory": "checkpoints/EucherHeuristicTiebreak",
    "interval": 1
  },
  "logging": {
    "directory": "logs/EucherHeuristicTiebreak"
  }
}
