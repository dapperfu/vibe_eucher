  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Test Different Strategy Combinations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test different strategy combinations\n",
    "print(\"🧪 TESTING DIFFERENT STRATEGY COMBINATIONS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "strategy_tests = [\n",
    "    {\n",
    "        'name': 'Aggressive vs Conservative',\n",
    "        'team1': [('North', 'aggressive', 0.8), ('South', 'aggressive', 0.8)],\n",
    "        'team2': [('East', 'conservative', 0.2), ('West', 'conservative', 0.2)]\n",
    "    },\n",
    "    {\n",
    "        'name': 'Balanced vs Opportunistic',\n",
    "        'team1': [('North', 'balanced', 0.5), ('South', 'balanced', 0.5)],\n",
    "        'team2': [('East', 'opportunistic', 0.7), ('West', 'opportunistic', 0.7)]\n",
    "    },\n",
    "    {\n",
    "        'name': 'Mixed Strategies',\n",
    "        'team1': [('North', 'aggressive', 0.8), ('South', 'conservative', 0.2)],\n",
    "        'team2': [('East', 'balanced', 0.5), ('West', 'opportunistic', 0.7)]\n",
    "    }\n",
    "]\n",
    "\n",
    "for test in strategy_tests:\n",
    "    print(f\"\\n🎯 Testing: {test['name']}\")\n",
    "    \n",
    "    # Create a new game for this test\n",
    "    test_game = EuchreGame(enable_logging=False)\n",
    "    \n",
    "    # Add players\n",
    "    for name, profile, risk in test['team1'] + test['team2']:\n",
    "        test_game.add_ai_player(name, profile, risk)\n",
    "    \n",
    "    # Start and play the game\n",
    "    test_game.start_new_game()\n",
    "    \n",
    "    round_count = 0\n",
    "    while not test_game.is_game_over() and round_count < 20:  # Limit rounds\n",
    "        test_game.play_round()\n",
    "        round_count += 1\n",
    "    \n",
    "    # Get results\n",
    "    if test_game.is_game_over():\n",
    "        winner = test_game.get_winner()\n",
    "        score1 = test_game.game_state.team1_score\n",
    "        score2 = test_game.game_state.team2_score\n",
    "        print(f\"  🏆 Winner: {winner}\")\n",
    "        print(f\"  📊 Score: {score1}-{score2}\")\n",
    "        print(f\"  ⏱️  Rounds: {round_count}\")\n",
    "    else:\n",
    "        print(f\"  ⏸️  Game incomplete after {round_count} rounds\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Interactive Card Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze card distributions and probabilities\n",
    "print(\"🃏 CARD ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Create a deck\n",
    "deck = []\n",
    "for suit in Suit:\n",
    "    for rank in Rank:\n",
    "        deck.append(Card(suit, rank))\n",
    "\n",
    "print(f\"🎴 Total cards in deck: {len(deck)}\")\n",
    "print(f\"♠️  Spades: {len([c for c in deck if c.suit == Suit.SPADES])}\")\n",
    "print(f\"♥️  Hearts: {len([c for c in deck if c.suit == Suit.HEARTS])}\")\n",
    "print(f\"♦️  Diamonds: {len([c for c in deck if c.suit == Suit.DIAMONDS])}\")\n",
    "print(f\"♣️  Clubs: {len([c for c in deck if c.suit == Suit.CLUBS])}\")\n",
    "\n",
    "# Deal a sample hand\n",
    "sample_hand = random.sample(deck, 5)\n",
    "print(f\"\\n👤 Sample 5-card hand:\")\n",
    "for card in sample_hand:\n",
    "    print(f\"  {card.rank.name} of {card.suit.name}\")\n",
    "\n",
    "# Count suits in hand\n",
    "suit_counts = {}\n",
    "for card in sample_hand:\n",
    "    suit = card.suit.name\n",
    "    suit_counts[suit] = suit_counts.get(suit, 0) + 1\n",
    "\n",
    "print(f\"\\n📊 Suit distribution in hand:\")\n",
    "for suit, count in suit_counts.items():\n",
    "    print(f\"  {suit}: {count} cards\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Risk Ratio Experimentation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test different risk ratios for the same strategy\n",
    "print(\"🎲 RISK RATIO EXPERIMENTATION\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "risk_ratios = [0.1, 0.3, 0.5, 0.7, 0.9]\n",
    "games_per_ratio = 10\n",
    "\n",
    "print(f\"🧪 Testing aggressive strategy with {games_per_ratio} games per risk ratio\")\n",
    "\n",
    "for risk_ratio in risk_ratios:\n",
    "    print(f\"\\n🎯 Risk ratio: {risk_ratio}\")\n",
    "    \n",
    "    wins = 0\n",
    "    total_rounds = 0\n",
    "    \n",
    "    for game_num in range(games_per_ratio):\n",
    "        # Create game\n",
    "        test_game = EuchreGame(enable_logging=False)\n",
    "        \n",
    "        # Add players: aggressive team vs balanced team\n",
    "        test_game.add_ai_player(\"North\", \"aggressive\", risk_ratio)\n",
    "        test_game.add_ai_player(\"South\", \"aggressive\", risk_ratio)\n",
    "        test_game.add_ai_player(\"East\", \"balanced\", 0.5)\n",
    "        test_game.add_ai_player(\"West\", \"balanced\", 0.5)\n",
    "        \n",
    "        # Play game\n",
    "        test_game.start_new_game()\n",
    "        \n",
    "        round_count = 0\n",
    "        while not test_game.is_game_over() and round_count < 25:\n",
    "            test_game.play_round()\n",
    "            round_count += 1\n",
    "        \n",
    "        if test_game.is_game_over():\n",
    "            if test_game.get_winner() == 'team1':\n",
    "                wins += 1\n",
    "            total_rounds += round_count\n",
    "    \n",
    "    win_rate = wins / games_per_ratio\n",
    "    avg_rounds = total_rounds / games_per_ratio\n",
    "    \n",
    "    print(f\"  🏆 Win rate: {win_rate:.1%} ({wins}/{games_per_ratio})\")\n",
    "    print(f\"  ⏱️  Avg rounds: {avg_rounds:.1f}\")"
   ]
  },
