   "source": [
    "# Euchre Game Playground\n",
    "\n",
    "This notebook provides an interactive playground for:\n",
    "- Testing different AI strategies\n",
    "- Experimenting with game parameters\n",
    "- Playing sample games\n",
    "- Analyzing individual game outcomes"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup and Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "# Add the parent directory to the path to import euchre modules\n",
    "sys.path.append(str(Path.cwd().parent))\n",
    "\n",
    "from euchre.game import EuchreGame\n",
    "from euchre.ai_profiles import AggressiveAI, ConservativeAI, BalancedAI, OpportunisticAI\n",
    "from euchre.models import Player, PlayerType, Card, Suit, Rank\n",
    "from euchre.game_logger import GameLogger\n",
    "import random\n",
    "\n",
    "print(\"✅ Imports successful\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create a Sample Game"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a new euchre game\n",
    "game = EuchreGame(enable_logging=True)\n",
    "print(\"🎮 New euchre game created\")\n",
    "print(f\"📝 Logging enabled: {game.enable_logging}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Add AI Players with Different Strategies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add AI players with different strategies\n",
    "print(\"🤖 Adding AI players...\")\n",
    "\n",
    "# Team 1: Aggressive strategy\n",
    "game.add_ai_player(\"North\", \"aggressive\", 0.8)\n",
    "game.add_ai_player(\"South\", \"aggressive\", 0.8)\n",
    "print(\"  ✅ Team 1: North (aggressive) + South (aggressive)\")\n",
    "\n",
    "# Team 2: Conservative strategy\n",
    "game.add_ai_player(\"East\", \"conservative\", 0.2)\n",
    "game.add_ai_player(\"West\", \"conservative\", 0.2)\n",
    "print(\"  ✅ Team 2: East (conservative) + West (conservative)\")\n",
    "\n",
    "print(f\"\\n🎯 Game setup complete with {len(game.players)} players\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Start the Game"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Start a new game\n",
    "print(\"🚀 Starting new game...\")\n",
    "game.start_new_game()\n",
    "\n",
    "print(f\"\\n🎴 Current game state:\")\n",
    "print(f\"  🃏 Trump suit: {game.game_state.trump_suit.name if game.game_state.trump_suit else 'Not set'}\")\n",
    "print(f\"  👥 Current player: {game.game_state.current_player.name}\")\n",
    "print(f\"  🎯 Dealer: {game.game_state.dealer.name}\")\n",
    "print(f\"  📊 Team 1 score: {game.game_state.team1_score}\")\n",
    "print(f\"  📊 Team 2 score: {game.game_state.team2_score}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Play a Few Rounds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Play a few rounds to see the game in action\n",
    "print(\"🎮 Playing rounds...\")\n",
    "round_num = 1\n",
    "max_rounds = 5  # Limit to avoid very long games\n",
    "\n",
    "while not game.is_game_over() and round_num <= max_rounds:\n",
    "    print(f\"\\n🔄 Round {round_num}\")\n",
    "    print(f\"  🃏 Trump: {game.game_state.trump_suit.name if game.game_state.trump_suit else 'Not set'}\")\n",
    "    print(f\"  👤 Current player: {game.game_state.current_player.name}\")\n",
    "    \n",
    "    # Play the round\n",
    "    results = game.play_round()\n",
    "    \n",
    "    print(f\"  📊 Round results: {results}\")\n",
    "    print(f\"  🏆 Team 1 score: {game.game_state.team1_score}\")\n",
    "    print(f\"  🎯 Team 2 score: {game.game_state.team2_score}\")\n",
    "    \n",
    "    round_num += 1\n",
    "    \n",
    "    # Check if game is over\n",
    "    if game.is_game_over():\n",
    "        print(f\"\\n🏁 Game over after {round_num-1} rounds!\")\n",
    "        break\n",
    "\n",
    "if not game.is_game_over():\n",
    "    print(f\"\\n⏸️  Stopped after {max_rounds} rounds (game still in progress)\")"
   ]
  },
