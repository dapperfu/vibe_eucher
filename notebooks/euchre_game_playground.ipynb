   "source": [
    "# Check if we have any game logs to analyze\n",
    "print(\"📝 GAME LOGGER ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Look for game log files in the parent directory\n",
    "parent_dir = Path.cwd().parent\n",
    "log_files = list(parent_dir.glob(\"euchre_game_*.txt\"))\n",
    "\n",
    "if log_files:\n",
    "    print(f\"📁 Found {len(log_files)} game log files\")\n",
    "    \n",
    "    # Show the most recent log\n",
    "    most_recent = max(log_files, key=lambda x: x.stat().st_mtime)\n",
    "    print(f\"\\n📄 Most recent log: {most_recent.name}\")\n",
    "    \n",
    "    # Read a portion of the log\n",
    "    try:\n",
    "        with open(most_recent, 'r') as f:\n",
    "            lines = f.readlines()\n",
    "            print(f\"\\n📊 Log file contains {len(lines)} lines\")\n",
    "            \n",
    "            # Show first few lines\n",
    "            print(\"\\n📖 First few lines:\")\n",
    "            for i, line in enumerate(lines[:10]):\n",
    "                print(f\"  {i+1}: {line.strip()}\")\n",
    "                \n",
    "            # Show last few lines\n",
    "            if len(lines) > 10:\n",
    "                print(\"\\n📖 Last few lines:\")\n",
    "                for i, line in enumerate(lines[-5:]):\n",
    "                    print(f\"  {len(lines)-4+i}: {line.strip()}\")\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"⚠️  Error reading log file: {e}\")\n",
    "else:\n",
    "    print(\"📁 No game log files found\")\n",
    "    print(\"💡 Run some games with logging enabled to see detailed game logs\")"
   ]
  }
